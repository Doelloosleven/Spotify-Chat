[Unit]
Description=Spotify Chat IRC <-> Discord bridge
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/spotify-chat-bridge/bridge.env
EnvironmentFile=/etc/spotify-chat-bridge/token.env
ExecStart=/opt/spotify-chat-bridge/venv/bin/python /opt/spotify-chat-bridge/bridge.py
Restart=always
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=200M

[Install]
WantedBy=multi-user.target
